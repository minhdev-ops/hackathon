APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypt session payload at rest; recommended for production.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true when serving over HTTPS (production).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Khoá grant (K_g) chỉ nằm trong store này, không ghi DB/log.
# Dùng "redis" khi có Redis; "file"/"array" khi dev cục bộ không có Redis.
GRANT_KEY_STORE=redis
GRANT_BUNDLE_DISK=local

# Chế độ mã hoá tài liệu (FR-VAULT-01/05): "tide" (chưa xác minh V1) hoặc "fallback" (mặc định).
ENC_MODE=fallback

# Quorum quản trị (FR-QRM)
QUORUM_THRESHOLD=2
QUORUM_REAUTH_MINUTES=5
# Bật khi đã cấu hình QEA cho realm (FR-QRM-05); mặc định fallback mức app.
TIDECLOAK_QEA_ENABLED=false

# LLM cho GenerateProposalJob / RunAgentJob: mock (mặc định), anthropic hoặc gemini
LLM_DRIVER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-latest
# Độ trễ mô phỏng mỗi bước của RunAgentJob (ms).
AGENT_STEP_DELAY_MS=200
# CACHE_PREFIX=

# TideCloak OIDC / JWKS (FR-AUTH-01..04, issue 01).
# TideCloak chạy trong Docker (tideorg/tidecloak-dev:latest) tại localhost:8080;
# Laravel chạy trên host bằng `php artisan serve` (127.0.0.1:8000).
# Đổi realm/client theo tide-console nếu bạn tạo cấu hình riêng.
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=myrealm
TIDECLOAK_CLIENT_ID=mytest
TIDECLOAK_AUDIENCE=mytest
TIDECLOAK_ISSUER=http://localhost:8080/realms/myrealm
TIDECLOAK_JWKS_CACHE_SECONDS=600

# Frontend OIDC (issue 02). Không chứa secret vì client là public.
VITE_TIDECLOAK_URL=http://localhost:8080
VITE_TIDECLOAK_REALM=myrealm
VITE_TIDECLOAK_CLIENT_ID=mytest

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bật nhóm route /demo/* (Làm admin xấu) khi true.
APP_DEMO=false

# Chế độ xác thực (SRS mục 12 — V2): session (demo tạm) | tide (Bearer JWT qua JWKS).
AUTH_MODE=session

# Chế độ mã hoá Vault (SRS mục 12 — V1): fallback (WebCrypto, đang chạy) | tide (chờ xác minh V1).
ENC_MODE=fallback
VAULT_DISK=local
VAULT_MAX_MB=10
